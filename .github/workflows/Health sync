name: Health sync

on:
  schedule:
    - cron: "17 12,22 * * *"
  workflow_dispatch:
    inputs:
      days:
        description: "Days to sync (use 90 for first backfill)"
        default: "3"

jobs:
  sync:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -r requirements.txt
      - run: python sync.py --days "${{ github.event.inputs.days || '3' }}"
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
          WHOOP_CLIENT_ID: ${{ secrets.WHOOP_CLIENT_ID }}
          WHOOP_CLIENT_SECRET: ${{ secrets.WHOOP_CLIENT_SECRET }}
          GARMIN_TOKENS: ${{ secrets.GARMIN_TOKENS }}
          TZ_NAME: America/New_York
